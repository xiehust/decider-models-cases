[Unit]
Description=strands-decider OpenAI-compatible chat completions API
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/strands-decider
Environment=HF_HOME=/opt/strands-decider/hf
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=DECIDER_PORT=8000
EnvironmentFile=-/etc/strands-decider.env
ExecStart=/opt/strands-decider/venv/bin/uvicorn openai_server:app --host 0.0.0.0 --port ${DECIDER_PORT} --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
